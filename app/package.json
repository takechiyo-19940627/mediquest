{
  "name": "mediquest-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "nuxt prepare && eslint .",
    "typecheck": "nuxt typecheck && tsc --project tsconfig.tools.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/test-e2e.ts && node scripts/test-e2e.ts --config playwright.admin.config.ts && playwright test --config playwright.preview.config.ts",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:seed": "node scripts/db-seed.ts",
    "db:backup": "node scripts/db-backup.ts",
    "db:restore": "node scripts/db-restore.ts"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "nuxt": "4.6.2",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "5.4.0",
    "drizzle-orm": "0.45.4",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "5.0.5",
    "vue-tsc": "^3.0.0",
    "drizzle-kit": "0.31.11",
    "@types/better-sqlite3": "9.6.0"
  },
  "packageManager": "npm@11.12.1"
}
