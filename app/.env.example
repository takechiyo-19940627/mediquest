MEDIQUEST_DB_PATH=/absolute/path/to/local-data/mediquest.sqlite
# Local-only fixed administrator. Never expose through a proxy or public listener.
MEDIQUEST_LOCAL_MODE=false
MEDIQUEST_LOCAL_ORIGIN=http://127.0.0.1:3000
# Explicit opt-in; keep disabled until you choose a model and supply a server-only key.
MEDIQUEST_GENERATION_ENABLED=false
ANTHROPIC_API_KEY=
MEDIQUEST_ANTHROPIC_MODEL=
# Required only for API keys not scoped to one workspace.
MEDIQUEST_ANTHROPIC_WORKSPACE_ID=
